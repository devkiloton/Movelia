@page "/"

<h1>I am @StringUtilities.UpperName("Yarego")</h1>
<button class="btn btn-primary" @onclick="@WriteInLog">Click me</button>
<p>Click counter: @num</p>

<div>
    <!-- If I don't use the conditional the browser will search for movies,
     but because of async method it will be a null reference -->
    @if(movies == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h3>Movie</h3>
        @foreach (var movie in movies)
        {
            <p>Title: <b>@movie.Title</b></p>
            <p>Release Date: <b>@movie.ReleaseDate.ToString("dd/MM/yyyy")</b></p>
        }
    }
    
</div>

@code
{
    private int num = 0;
    private List<Movie> movies;
    protected async override Task OnInitializedAsync()
    {
        await Task.Delay(3000);
        movies = new List<Movie>()
        {
            new Movie(){Title = "Spider Man: Far from home",ReleaseDate = new DateTime(2019, 7, 2)},
            new Movie(){Title = "Moana",ReleaseDate = new DateTime(2016, 11, 23)},
            new Movie(){Title = "Inception",ReleaseDate = new DateTime(2010, 7, 16)},
        };
    }
    
    public void WriteInLog()
    {
        Console.WriteLine("I've been clicked");
        num++;
    }
}
