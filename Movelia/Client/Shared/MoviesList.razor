@*//the second @ is a Event that uses a lambda expression*@
<input type="checkbox" @bind="@displayButtons"/>

<GenericList List="Movies">
    <ElementTemplate Context="movie">
        <IndividualMovies Movie="movie" DisplayButtons="displayButtons" DeleteMovie="DeleteMovie"/>
    </ElementTemplate>
</GenericList>

@code
{
    [Parameter]public List<Movie> Movies {get; set;}
    private bool displayButtons = true;

    private void DeleteMovie(Movie movie)
    {
        Movies.Remove(movie);
    }
}